# Backend Environment Configuration Example
# Copy this file to .env before starting the server in production

# Security
JWT_SECRET=change-this-to-a-secure-random-32-byte-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite by default, PostgreSQL supported)
DATABASE_URL=sqlite:///./automotora.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
