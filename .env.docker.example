# ============================================================
# Docker Environment Variables
# Copy this file to .env.docker before running docker compose
# ============================================================

# ── Security ───────────────────────────────────────────────
# IMPORTANT: Change this to a secure random secret in production!
JWT_SECRET=change-this-to-a-secure-random-32-byte-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ───────────────────────────────────────────────
# SQLite (default, persisted in a Docker volume)
DATABASE_URL=sqlite:///./data/automotora_crm.db

# PostgreSQL (uncomment for production)
# DATABASE_URL=postgresql://user:password@db:5432/automotora_crm

# ── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://frontend:80

# ── Port Mapping (host ports) ─────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
